{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Data Assessment v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recording_id",
    "signal_quality",
    "usable_bands",
    "main_risks",
    "recommended_feature_families",
    "do_not_do",
    "confidence"
  ],
  "properties": {
    "recording_id": { "type": "string" },
    "signal_quality": { "type": "string", "enum": ["low", "medium", "high"] },
    "usable_bands": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["delta", "theta", "alpha", "beta", "low_gamma"] },
      "uniqueItems": true
    },
    "main_risks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 3, "maxLength": 120 }
    },
    "recommended_feature_families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 3, "maxLength": 80 },
      "uniqueItems": true
    },
    "do_not_do": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 3, "maxLength": 120 },
      "uniqueItems": true
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
