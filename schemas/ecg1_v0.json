{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ECG 1-lead schema v0",
  "type": "object",
  "required": ["schema_version", "sampling_rate_hz", "channels", "units", "csv"],
  "properties": {
    "schema_version": { "const": "ecg1_v0" },
    "sampling_rate_hz": { "type": "number", "minimum": 1 },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "string", "const": "ECG" }
    },
    "units": { "type": "string" },
    "csv": {
      "type": "object",
      "required": ["path", "time_column", "signal_columns", "has_label"],
      "properties": {
        "path": { "type": "string" },
        "time_column": { "type": "string" },
        "signal_columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "const": "ECG" }
        },
        "label_column": { "type": "string" },
        "has_label": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "quality_assumptions": {
      "type": "object",
      "properties": {
        "expected_mV_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
        "max_missing_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
