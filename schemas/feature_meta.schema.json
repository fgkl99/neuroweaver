{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroweaver.local/schemas/feature_meta.schema.json",
  "title": "NeuroWeaver Feature Meta",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "description", "inputs", "outputs"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9_\\-]+$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels"],
      "properties": {
        "channels": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "sampling_rate_hz_min": { "type": "number" },
        "sampling_rate_hz_max": { "type": "number" }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "unit": { "type": "string" },
          "expected_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" }
          }
        }
      }
    }
  }
}
